# demo (scripted agents, no keys) or live (real models via OpenRouter)
MODE=demo
OPENROUTER_API_KEY=
MAX_ROUNDS=4

# Telegram bot (orchestrator bot)
TELEGRAM_BOT_TOKEN=
# Your Telegram user id(s), comma-separated; everyone else is refused
ALLOWED_USER_IDS=

DB_PATH=orchestrator.db
ROLES_PATH=roles.yaml
